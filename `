# Paths
MODEL_PATH: "src/models"           # base directory; --weights_path overrides
PROBLEMS_PATH: "src/data"
MODEL_OUTPUT: "src/results"

# Validation settings
#   Local (Windows): VAL/ contains Jan Dolejsi PDDL-extension binaries (Validate.exe).
#   Linux / Leonardo: drop a Linux build into VAL/ (Validate, no .exe), flip VAL_EXECUTABLE.
VAL_PATH: "VAL"
VAL_EXECUTABLE: "Validate.exe"
VAL_TIMEOUT: 300

# Multi-GPU settings
DEVICE_MAP: "auto"
MAX_GPU_MEMORY: null

# Execution
BATCH_SIZE: 1

# --------------------------------------------------------------------
# Experiment axes (STEPS.md §0.2)
# --------------------------------------------------------------------
domains:
  active:    [blocksworld, citycar, tetris]
  available: [blocksworld, citycar, tetris, basic_move, folding, gripper, hanoi, labyrinth, logistics, monkey, shoe-sock, travel]

models:
  active: [llama8, qwen25, llama33]

conditions: [baseline, cot]

generation:
  temperature:     0.6
  top_p:           0.95
  top_k:           10
  max_new_tokens:  8192
  stop:            null
  seed:            42

iteration:
  policy:         stop_on_success
  max_iterations: 4

# Legacy keys consumed by existing code paths — kept in sync with the
# canonical values above so both old and new code read the same settings.
MAX_TOKENS:          8192
TEMPERATURE:         0.6
TOP_K:               10
DEFAULT_ITERATIONS:  4
