(define (problem visit-all-5-line)
  (:domain visit-all)
  (:objects p1 p2 p3 p4 p5 - place)
  (:init
    (at-robot p1)
    (visited p1)
    (connected p1 p2) (connected p2 p1)
    (connected p2 p3) (connected p3 p2)
    (connected p3 p4) (connected p4 p3)
    (connected p4 p5) (connected p5 p4)
  )
  (:goal (and (visited p1) (visited p2) (visited p3) (visited p4) (visited p5)))
)
