(define (problem visit-all-4-line)
  (:domain visit-all)
  (:objects p1 p2 p3 p4 - place)
  (:init
    (at-robot p1)
    (visited p1)
    (connected p1 p2) (connected p2 p1)
    (connected p2 p3) (connected p3 p2)
    (connected p3 p4) (connected p4 p3)
  )
  (:goal (and (visited p1) (visited p2) (visited p3) (visited p4)))
)
