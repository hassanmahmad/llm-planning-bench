(define (problem visit-all-7-tree)
  (:domain visit-all)
  (:objects r a b a1 a2 b1 b2 - place)
  (:init
    (at-robot r)
    (visited r)
    (connected r a)  (connected a r)
    (connected r b)  (connected b r)
    (connected a a1) (connected a1 a)
    (connected a a2) (connected a2 a)
    (connected b b1) (connected b1 b)
    (connected b b2) (connected b2 b)
  )
  (:goal (and (visited r) (visited a) (visited b)
              (visited a1) (visited a2) (visited b1) (visited b2)))
)
